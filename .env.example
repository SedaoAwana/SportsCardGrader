# eBay developer credentials (free): https://developer.ebay.com — used for price comps.
# The app runs without them; scans just won't include market prices.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Pricing adapter (see server/app/pricing.py to plug in a sold-price provider).
# PRICING_SOURCE=ebay_active

# Hive publishing — "The Binder" community (docs/hive-setup.md).
# Posting key ONLY (never active/owner). Leave blank to disable publishing.
HIVE_ACCOUNT=
HIVE_POSTING_KEY=
# HIVE_COMMUNITY=hive-192941
# HIVE_DRY_RUN=false            # true = log ops instead of broadcasting
# HIVE_NODES=                   # comma-separated RPC node override
# IMAGES_3SPEAK_TOKEN=          # optional images.hive.blog fallback
